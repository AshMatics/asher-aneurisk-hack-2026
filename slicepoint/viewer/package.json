{
  "name": "slicepoint-viewer",
  "version": "0.2.2",
  "private": true,
  "description": "SlicePoint viewer: a static build that renders an AssessmentResult JSON offline, and a live build served by slicepoint-api.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "gen:contract": "node scripts/gen-contract.mjs",
    "check:contract": "node scripts/gen-contract.mjs --check",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "node scripts/gen-contract.mjs --check && tsc --noEmit -p tsconfig.json && vite build && node scripts/check-build.mjs",
    "build:core": "pnpm build && node scripts/sync-core.mjs",
    "build:live": "node scripts/gen-api.mjs --check && tsc --noEmit -p tsconfig.json && vite build --mode live && node scripts/check-live.mjs",
    "build:api": "pnpm build:live && node scripts/sync-api.mjs",
    "preview": "vite preview",
    "verify": "pnpm check:contract && pnpm check:api && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm build:live"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "openapi-typescript>typescript": "6"
      }
    },
    "overrides": {
      "minimatch@<11.0.1": "^11.0.1"
    }
  }
}
